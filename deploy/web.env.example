# Settings of this installation. Copy to /opt/crm/deploy/web.env and fill in. Nothing secret is
# written to the app: the anon key is public by design, it is the key of the browser.
WEB_DOMAIN=crm.example.ru
API_DOMAIN=api.example.ru
# Where the Supabase files live on this server
SUPABASE_DIR=/opt/supabase
# The same address as API_DOMAIN, with https://
VITE_SUPABASE_URL=https://api.example.ru
# ANON_KEY from /opt/supabase/.env
VITE_SB_PUBLISHABLE_KEY=
VITE_IS_DEMO=false
VITE_ATTACHMENTS_BUCKET=attachments

# --- Daily backup into a PRIVATE GitHub repository (see deploy/README.md, "Backups") ---
# SSH address of the private repository that holds only the encrypted copies
BACKUP_REPO=git@github.com:YOUR-ACCOUNT/crm-backups.git
# PUBLIC key of age (starts with "age1"): the server can encrypt, it cannot decrypt
BACKUP_AGE_RECIPIENT=
